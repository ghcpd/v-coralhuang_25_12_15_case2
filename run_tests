#!/usr/bin/env python3
"""Run the test suite and exit with non-zero code on failure."""
import sys
import unittest

loader = unittest.TestLoader()
# Explicitly discover tests under the tests/ directory for reliability
suite = loader.discover("tests", pattern="test_*.py")
runner = unittest.TextTestRunner(verbosity=2)
result = runner.run(suite)
if not result.wasSuccessful():
    sys.exit(1)
